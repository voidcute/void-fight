{
    // The ID of your mod. Should be unique!!
    "id": "voidfight",
    // Displays on the main menu.
    "name": "voidfight",
    // Displays underneath the name. Optional.
    "subtitle": "",

    // The version of your mod.
    "version": "v0.0.1",
    // What version of the engine your mod was made with.
    "engineVer": "v0.10.0-dev",

    // The Deltarune chapter you'd like to base your mod off of.
    // Do keep in mind that you can control chapter-specific features
    // one by one using the config below.
    "chapter": 4,

    // The map that you start in when first starting the mod.
    "map": "void_meeting_room",

    // The party. The first character is the player.
    "party": ["frisk"],

    // The inventory. Contains three darkburgers, a cell phone and a shadow crystal by default.
    "inventory": {
        // "items": ["undertale/rock_candy", "undertale/monster_candy", "undertale/spider_donut", "undertale/spider_cider", "undertale/butterscotch_pie", "undertale/ghost_fruit"],
        "items": ["undertale/bisicle","undertale/bisicle","undertale/bisicle","undertale/bisicle","undertale/bisicle","undertale/bisicle","undertale/bisicle","undertale/bisicle"],
        "box_a": ["undertale/stick", "undertale/toy_knife", "undertale/tough_glove", "undertale/ballet_shoes", "undertale/torn_notebook", "undertale/burnt_pan", "undertale/empty_gun", "undertale/worn_dagger", "undertale/real_knife"],
        "box_b": ["undertale/bandage", "undertale/faded_ribbon", "undertale/manly_bandanna", "undertale/old_tutu", "undertale/cloudy_glasses", "undertale/stained_apron", "undertale/cowboy_hat", "undertale/heart_locket", "undertale/the_locket", "undertale/temy_armor"],
        "key_items": ["cell_phone"]
    },
    // Equipment for your party. Not specifying equipment defaults to the following.


    // Should never be true, but just in case. Restarts the entire engine when leaving the mod.
    // If you need this, you're most likely doing something wrong.
    "hardReset": false,

    // Whether the mod is hidden from the mod selection.
    "hidden": false,

    // Whether the game window's title should be set to the mod's name, and the icon to the image
    // in the file `window_icon.png`.
    // When your mod is configured as the engine's target mod, it's automatically done unless if
    // this option is explicitly set to false; else, it's done if this is set to true.
    "setWindowTitleAndIcon": null,
    "useSaves": false,
    // Config values for the engine and any libraries you may have.
    // These config values can control chapter-specific features as well.
    "config": {
        "kristal": {
            "lightCurrency": "Gold",
            "lightCurrencyShort": "G",
            "overworldSpells": true,
            "canTossLightWeapons": true,
            //"targetSystem": true,
            // End of config
        },
        "magical-glass": {
        //"default_battle_system": ["undertale", true],
            //"hp_gauge_length_cap": true,
            "undertale_menu_display": true,
            "light_battle_tp": false,
            "mercy_messages": false,
            "tired_messages": false,
            "awake_messages": false,
            "mercy_bar": false,
            "enemy_bar_percentages": false,
            "light_inventory_equipment_conversion": false,
            "savepoint_style": "undertale",
            "text_choicebox_sound": true,
            "debug": true,
            "undertale_movement_can_run": false
    }
}
}